if(NOT DEFINED OUTPUT OR NOT DEFINED ROOTS)
  message(FATAL_ERROR "Managed UI manifest needs OUTPUT and ROOTS")
endif()
set(_entries)
foreach(_spec IN LISTS ROOTS)
  string(FIND "${_spec}" "=" _separator)
  if(_separator LESS 0)
    message(FATAL_ERROR "Managed UI root must be prefix=directory")
  endif()
  string(SUBSTRING "${_spec}" 0 ${_separator} _prefix)
  math(EXPR _start "${_separator} + 1")
  string(SUBSTRING "${_spec}" ${_start} -1 _root)
  file(GLOB_RECURSE _sources "${_root}/*.lua")
  list(SORT _sources)
  foreach(_source IN LISTS _sources)
    file(SHA256 "${_source}" _hash)
    file(RELATIVE_PATH _path "${_root}" "${_source}")
    if(NOT _prefix STREQUAL "")
      set(_path "${_prefix}/${_path}")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hash}")
    list(APPEND _entries "  UiSource{\"${_path}\", Sha256Digest{${_bytes}}},\n")
  endforeach()
endforeach()
list(LENGTH _entries _count)
set(_text "#pragma once\n#include <array>\n#include \"core/distribution.h\"\nnamespace hailstone::distribution {\ninline constexpr std::array<UiSource, ${_count}> kManagedUiSources{{\n")
foreach(_entry IN LISTS _entries)
  string(APPEND _text "${_entry}")
endforeach()
string(APPEND _text "}};\n}\n")
get_filename_component(_parent "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_parent}")
file(WRITE "${OUTPUT}.tmp" "${_text}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
